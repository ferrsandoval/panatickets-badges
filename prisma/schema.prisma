generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PrintJob {
  id          String    @id @default(cuid())
  scanId      String?   @unique @map("scan_id")
  contentHash String?   @unique @map("content_hash")
  name        String
  point       String?   @map("point")
  empresa     String?   @map("empresa")
  pais        String?   @map("pais")
  feria       String?   @map("feria")
  /// ID del evento tal como lo manda Showare (evento_id). Permite filtrar la
  /// cola de impresión por evento dentro de la base compartida "showare",
  /// ya que los eventos de Showare son dinámicos (no tienen base propia).
  eventoId    String?   @map("evento_id")
  telefono    String?   @map("telefono")
  email       String?   @map("email")
  rawPayload  String?   @map("raw_payload")
  source      String?   @map("source")
  printedAt   DateTime? @map("printed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([point, printedAt, createdAt])
  @@index([eventoId])
  @@map("print_jobs")
}

/// Datos escaneados: Scan_ID, Fecha, Hora, Dia_Semana, Timestamp_Completo, EXPO, Tipo_Persona, Nombre, Empresa, Email, Telefono, Celular, Escaneo
model ScanRecord {
  id                String   @id @default(cuid())
  scanId            String?  @map("scan_id")
  fecha             String?  @map("fecha")
  hora              String?  @map("hora")
  diaSemana         String?  @map("dia_semana")
  timestampCompleto String?  @map("timestamp_completo")
  expo              String?  @map("expo")
  tipoPersona       String?  @map("tipo_persona")
  nombre            String?  @map("nombre")
  empresa           String?  @map("empresa")
  email             String?  @map("email")
  telefono          String?  @map("telefono")
  celular           String?  @map("celular")
  escaneo           String?  @map("escaneo")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([expo])
  @@index([tipoPersona])
  @@index([nombre, empresa, email])
  @@index([fecha])
  @@index([hora])
  @@map("scan_records")
}

/// Tabla auxiliar central: lookup QR completo -> país (cargada desde CSV).
/// Expos normales: CSV qr_content,pais (2 columnas). Expos EXPOSITORES: CSV QR Content,Empresa,País (3 columnas).
model QrCountryLookup {
  id        String   @id @default(cuid())
  qrContent String   @unique @map("qr_content")
  empresa   String?  @map("empresa")
  pais      String   @map("pais")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("qr_country_lookup")
}

/// Lookup de boletos: el QR es un código de barras opaco (sin texto Nombre=...
/// embebido), así que nombre/categoría/tipo de boleto se resuelven contra esta
/// tabla en vez de parsearse del propio QR. Cargada desde CSV de venta de boletos.
model TicketLookup {
  id          String   @id @default(cuid())
  qrContent   String   @unique @map("qr_content")
  nombre      String   @map("nombre")
  categoria   String?  @map("categoria")
  tipoBoleto  String?  @map("tipo_boleto")
  telefono    String?  @map("telefono")
  email       String?  @map("email")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("ticket_lookup")
}

/// Configuración general de la etiqueta/expo. Fila única (singleton, id fijo
/// "singleton") por proyecto, actualizada por upsert.
model ExpoSettings {
  id          String   @id
  expoName    String?  @map("expo_name")
  printQr     Boolean  @default(true) @map("print_qr")
  /// JSON string[] con el orden/selección de campos a imprimir, ej.
  /// ["name","empresa","pais","expo"]. Valores válidos: name, empresa, pais,
  /// telefono, email, expo.
  labelFields String?  @map("label_fields")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("expo_settings")
}

/// Puntos de impresión autorizados de esta expo (reemplaza el mapa fijo
/// AUTHORIZED_POINT_BY_USER_ID hardcodeado en el webhook de CodeREADr).
model PrintPoint {
  id                String   @id @default(cuid())
  key               String   @unique @map("key")
  label             String   @map("label")
  /// JSON string[] con los "User ID" de CodeREADr autorizados a escanear
  /// hacia este punto.
  authorizedUserIds String?  @map("authorized_user_ids")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("print_points")
}
